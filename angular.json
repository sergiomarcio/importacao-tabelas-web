{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
      "integra-web": {
        "projectType": "application",
        "schematics": {
          "@schematics/angular:component": {
            "style": "scss"
          }
        },
        "root": "",
        "sourceRoot": "src",
        "prefix": "app",
        "architect": {
          "build": {
            "builder": "@angular-devkit/build-angular:browser",
            "options": {
              "allowedCommonJsDependencies": [
                "pdfmake",
                "sweetalert2",
                "quill",
                "html-to-pdfmake"
              ],
              "outputPath": "dist",
              "index": "src/index.html",
              "main": "src/main.ts",
              "polyfills": "src/polyfills.ts",
              "tsConfig": "tsconfig.app.json",
              "aot": true,
              "assets": [
                "src/assets",
                "src/404.html",
                "src/favicon.ico"
              ],
              "styles": [
                "src/styles.scss",
                "src/assets/fontawesome/css/brands.min.css",
                "src/assets/fontawesome/css/solid.min.css",
                "src/assets/fontawesome/css/fontawesome.min.css"
              ],
              "scripts": [
                "node_modules/prismjs/prism.js"
              ]
            },
            "configurations": {
              "production": {
                "budgets": [
                  {
                    "type": "initial",
                    "maximumWarning": "20mb",
                    "maximumError": "20mb"
                  },
                  {
                    "type": "anyComponentStyle",
                    "maximumWarning": "1mb",
                    "maximumError": "1mb"
                  }
                ],
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.prod.ts"
                  }
                ],
                "outputHashing": "all"
              },
              "dev": {
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.dev.ts"
                  }
                ],
                "optimization": false,
                "vendorChunk": true,
                "extractLicenses": false,
                "sourceMap": true,
                "namedChunks": true
              },
              "hom": {
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.hom.ts"
                  }
                ],
                "optimization": false,
                "vendorChunk": true,
                "extractLicenses": false,
                "sourceMap": true,
                "namedChunks": true,
                "outputHashing": "all"
              },
              "local": {
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.local.ts"
                  }
                ],
                "optimization": false,
                "vendorChunk": true,
                "extractLicenses": false,
                "sourceMap": true,
                "namedChunks": true
              },
              "ec": {
                "budgets": [
                  {
                    "type": "anyComponentStyle",
                    "maximumWarning": "6kb"
                  }
                ],
                "sourceMap": true
              }
            },
            "defaultConfiguration": "production"
          },
          "serve": {
            "builder": "@angular-devkit/build-angular:dev-server",
            "options": {
              "buildTarget": "integra-web:build"
            },
            "configurations": {
              "production": {
                "buildTarget": "integra-web:build:production"
              },
              "dev": {
                "buildTarget": "integra-web:build:dev"
              },
              "hom": {
                "buildTarget": "integra-web:build:hom"
              },
              "local": {
                "buildTarget": "integra-web:build:local"
              }
            },
            "defaultConfiguration": "local"
          },
          "extract-i18n": {
            "builder": "@angular-devkit/build-angular:extract-i18n",
            "options": {
              "buildTarget": "integra-web:build"
            }
          },
          "test": {
            "builder": "@angular-devkit/build-angular:karma",
            "options": {
              "main": "src/test.ts",
              "polyfills": "src/polyfills.ts",
              "tsConfig": "tsconfig.spec.json",
              "karmaConfig": "karma.conf.js",
              "scripts": [],
              "styles": [
                "src/styles.scss"
              ],
              "assets": [
                "src/assets",
                "src/404.html",
                "src/favicon.ico"
              ]
            }
          }
        }
      }
    },
    "cli": {
      "analytics": false
    }
  }